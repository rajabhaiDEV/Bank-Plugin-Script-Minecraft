# =======================================================
#         BANK SYSTEM (FULL GLITCH-PROOF & SAFE) By [ rajabgamerOG ] 
# =======================================================

on join:
    if {bank::%uuid of player%} is not set:
        set {bank::%uuid of player%} to 0

command /bank:
    trigger:
        if {bank::%uuid of player%} is not set:
            set {bank::%uuid of player%} to 0
            
        set {_gui} to a new chest inventory with 3 rows named "&8» &1&lBANKING SYSTEM"
        set {_glass} to gray stained glass pane named " "
        loop 27 times:
            set slot (loop-value - 1) of {_gui} to {_glass}
        
        set slot 11 of {_gui} to gold ingot named "&e&lWITHDRAW CASH" with lore "&7Withdraw funds from bank." and "" and "&e&l► Click to Open"
        set slot 13 of {_gui} to nether star named "&b&lTOTAL BANK MONEY" with lore "&7Current Bank Balance:" and "&a$%{bank::%uuid of player%}%" and "" and "&7Safe in bank!"
        set slot 15 of {_gui} to chest named "&a&lDEPOSIT CASH" with lore "&7Deposit cash into bank." and "" and "&e&l► Click to Open"
        
        open {_gui} to player

command /bankwithdrawgui:
    trigger:
        set {_gui} to a new chest inventory with 3 rows named "&8» &c&lWITHDRAW OPTIONS"
        set {_glass} to gray stained glass pane named " "
        loop 27 times:
            set slot (loop-value - 1) of {_gui} to {_glass}
            
        set slot 11 of {_gui} to gold nugget named "&e&lWITHDRAW HALF (50%%%%)" with lore "&7Bank Total: &a$%{bank::%uuid of player%}%" and "" and "&e&l► Click to Withdraw"
        set slot 15 of {_gui} to gold block named "&c&lWITHDRAW ALL (100%%%%)" with lore "&7Bank Total: &a$%{bank::%uuid of player%}%" and "" and "&c&l► Click to Withdraw All"
        set slot 22 of {_gui} to barrier named "&c&lBACK"
        
        open {_gui} to player

command /bankdepositgui:
    trigger:
        set {_gui} to a new chest inventory with 3 rows named "&8» &a&lDEPOSIT OPTIONS"
        set {_glass} to gray stained glass pane named " "
        loop 27 times:
            set slot (loop-value - 1) of {_gui} to {_glass}
            
        set slot 11 of {_gui} to chest named "&a&lDEPOSIT HALF (50%%%%)" with lore "&7Pocket Cash: &a$%player's balance%" and "" and "&a&l► Click to Deposit"
        set slot 15 of {_gui} to trapped chest named "&2&lDEPOSIT ALL (100%%%%)" with lore "&7Pocket Cash: &a$%player's balance%" and "" and "&2&l► Click to Deposit All"
        set slot 22 of {_gui} to barrier named "&c&lBACK"
        
        open {_gui} to player

# =======================================================
#                  CLICK EVENTS (SAFE ENGINE)
# =======================================================

on inventory click:
    if name of event-inventory is "&8» &1&lBANKING SYSTEM":
        cancel event
        if index of clicked slot is 11:
            execute player command "/bankwithdrawgui"
        else if index of clicked slot is 15:
            execute player command "/bankdepositgui"
            
    else if name of event-inventory is "&8» &c&lWITHDRAW OPTIONS":
        cancel event
        set {_bankbal} to {bank::%uuid of player%}
        
        # WITHDRAW 50%
        if index of clicked slot is 11:
            if {_bankbal} > 0:
                set {_amt} to {_bankbal} / 2
                subtract {_amt} from {bank::%uuid of player%}
                set {_cleanAmt} to "%{_amt}%"
                replace all "$" and "," with "" in {_cleanAmt}
                execute console command "eco give %player% %{_cleanAmt}%"
                send "&a&lBANK &8» &7Withdrawn &a$%{_amt}%&7! New Bank Balance: &a$%{bank::%uuid of player%}%" to player
                close player's inventory
            else:
                send "&c&lBANK &8» &7Bank me paise nahi hain!" to player
                close player's inventory

        # WITHDRAW 100%
        else if index of clicked slot is 15:
            if {_bankbal} > 0:
                set {_amt} to {_bankbal}
                set {bank::%uuid of player%} to 0
                set {_cleanAmt} to "%{_amt}%"
                replace all "$" and "," with "" in {_cleanAmt}
                execute console command "eco give %player% %{_cleanAmt}%"
                send "&a&lBANK &8» &7Withdrawn all &a$%{_amt}%&7! New Bank Balance: &a$0" to player
                close player's inventory
            else:
                send "&c&lBANK &8» &7Bank me paise nahi hain!" to player
                close player's inventory

        else if index of clicked slot is 22:
            execute player command "/bank"

    else if name of event-inventory is "&8» &a&lDEPOSIT OPTIONS":
        cancel event
        # Clean Player Balance calculation
        set {_pbalRaw} to "%player's balance%"
        replace all "$" and "," with "" in {_pbalRaw}
        set {_pbal} to {_pbalRaw} parsed as number
        
        # DEPOSIT 50%
        if index of clicked slot is 11:
            if {_pbal} > 0:
                set {_amt} to {_pbal} / 2
                set {_cleanAmt} to "%{_amt}%"
                replace all "$" and "," with "" in {_cleanAmt}
                execute console command "eco take %player% %{_cleanAmt}%"
                add {_amt} to {bank::%uuid of player%}
                send "&a&lBANK &8» &7Deposited &a$%{_amt}%&7! New Bank Balance: &a$%{bank::%uuid of player%}%" to player
                close player's inventory
            else:
                send "&c&lBANK &8» &7Pocket me cash nahi hai!" to player
                close player's inventory

        # DEPOSIT 100%
        else if index of clicked slot is 15:
            if {_pbal} > 0:
                set {_amt} to {_pbal}
                set {_cleanAmt} to "%{_amt}%"
                replace all "$" and "," with "" in {_cleanAmt}
                execute console command "eco take %player% %{_cleanAmt}%"
                add {_amt} to {bank::%uuid of player%}
                send "&a&lBANK &8» &7Deposited all &a$%{_amt}%&7! New Bank Balance: &a$%{bank::%uuid of player%}%" to player
                close player's inventory
            else:
                send "&c&lBANK &8» &7Pocket me cash nahi hai!" to player
                close player's inventory

        else if index of clicked slot is 22:
            execute player command "/bank"
